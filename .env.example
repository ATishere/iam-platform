# ============================================
# IAM Platform - Environment Variables
# Copy file này thành .env và điền giá trị thật.
# KHÔNG commit file .env lên git.
# ============================================

# --- Application ---
APP_NAME=IAM Platform
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Security (BẮT BUỘC đổi khi deploy) ---
# Generate bằng: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_64
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256

# --- Argon2id (theo spec: time_cost=3, memory_cost=64MiB, parallelism=4) ---
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16

# --- Account lockout ---
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# --- Database ---
POSTGRES_USER=iam
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=iam_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://iam:CHANGE_ME_postgres_password@postgres:5432/iam_platform

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Rate limiting (Phase 4) ---
RATELIMIT_ENABLED=true
RATELIMIT_KEY_PREFIX=iam:rl
RATELIMIT_LOGIN_IP_LIMIT=10
RATELIMIT_LOGIN_IP_WINDOW=60
RATELIMIT_LOGIN_ACCOUNT_LIMIT=5
RATELIMIT_LOGIN_ACCOUNT_WINDOW=60
RATELIMIT_REFRESH_IP_LIMIT=30
RATELIMIT_REFRESH_IP_WINDOW=60
RATELIMIT_REGISTER_IP_LIMIT=5
RATELIMIT_REGISTER_IP_WINDOW=300
RATELIMIT_FORGOT_IP_LIMIT=3
RATELIMIT_FORGOT_IP_WINDOW=300
RATELIMIT_FORGOT_EMAIL_LIMIT=3
RATELIMIT_FORGOT_EMAIL_WINDOW=3600

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Phase 5) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Seed (chạy python -m app.scripts.seed) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_seed_admin_password_min_12_chars
